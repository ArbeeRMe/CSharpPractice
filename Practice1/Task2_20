using System;
namespace ConsoleApplication1
{
    class Program
    {
        static void Main()
        {
            Console.WriteLine("Введите первый символ");
            int x = Console.Read();
            Console.ReadLine();
            Console.WriteLine("Введите второй символ");
            int y = Console.Read();
            int result = x+y;
            Console.WriteLine("Вы получили символ: " + Convert.ToChar(result));
        }
    }
} 
